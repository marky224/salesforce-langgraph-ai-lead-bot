# =============================================================================
# AI Sales Lead Bot — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# =============================================================================

# --- LLM Configuration ------------------------------------------------------
LLM_PROVIDER=xai                         # anthropic | openai | groq | xai
LLM_MODEL=                               # Optional override (default per provider)
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=60                    # per-call LLM timeout (seconds); kills hung calls
LLM_MAX_RETRIES=2                        # bounded retries on transient LLM errors
LLM_STRUCTURED_OUTPUT=false              # opt-in: provider-native structured extraction/routing

# Provider API keys (only the active provider's key is required)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=

# --- Salesforce OAuth --------------------------------------------------------
SF_INSTANCE_URL=https://your-domain.develop.my.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=
SF_REQUEST_TIMEOUT=30                     # timeout (seconds) for Salesforce OAuth token calls

# --- Server ------------------------------------------------------------------
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,https://markandrewmarquez.com,https://zealous-moss-0360b7210.7.azurestaticapps.net
LOG_LEVEL=INFO

# Per-IP rate limit for the chat endpoints (slowapi syntax, e.g. "20/minute").
RATE_LIMIT=20/minute

# --- Persistence -------------------------------------------------------------
# Durable conversation state (LangGraph checkpointer). Leave blank for local
# dev/tests (in-memory MemorySaver). In production set this to a Neon Postgres
# DIRECT (non-pooled) connection string — the validated default. (The pooled endpoint
# also works as of 2026-06-08: Neon's pooler now supports the saver's psycopg3 prepared statements.)
DATABASE_URL=

# --- Azure Deployment (reference) -------------------------------------------
# Resource Group:        rg-ai-lead-bot
# Container App:         salesforce-langgraph-ai-lead-bot
# Container Registry:    aileadbotacr
# Static Web App:        ai-lead-bot-widget
# Region:                centralus
